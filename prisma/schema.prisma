generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id               String         @id @default(uuid())
  clerkId          String         @unique
  firstName        String
  lastName         String
  userName         String
  email            String
  profileImage     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  landmarks        Landmark[]
  favorites        Favorite[]
  comments         Comment[]
  conversationsAsA Conversation[] @relation("ConversationUserA")
  conversationsAsB Conversation[] @relation("ConversationUserB")
  sentMessages     Message[]      @relation("MessageSender")
}

model Landmark {
  id          String     @id @default(uuid())
  name        String
  description String
  category    String
  image       String
  province    String
  lat         Float
  lng         Float
  price       Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  profile     Profile    @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
  profileId   String
  favorites   Favorite[]
  comments    Comment[]

  @@index([updatedAt(sort: Desc)])
  @@index([profileId])
}

model Favorite {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  profile    Profile  @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
  profileId  String
  landmark   Landmark @relation(fields: [landmarkId], references: [id], onDelete: Cascade)
  landmarkId String

  @@index([profileId])
  @@index([landmarkId])
}

model Comment {
  id         String    @id @default(uuid())
  comment    String
  rating     Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  profile    Profile   @relation(fields: [profileId], references: [clerkId], onDelete: Cascade)
  profileId  String
  landmark   Landmark  @relation(fields: [landmarkId], references: [id], onDelete: Cascade)
  landmarkId String
  parentId   String?
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")

  @@index([landmarkId, createdAt(sort: Desc)])
  @@index([parentId])
}

model Conversation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userAId   String
  userBId   String
  userA     Profile   @relation("ConversationUserA", fields: [userAId], references: [clerkId])
  userB     Profile   @relation("ConversationUserB", fields: [userBId], references: [clerkId])
  messages  Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  createdAt      DateTime     @default(now())
  senderId       String
  conversationId String
  isRead         Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Profile      @relation("MessageSender", fields: [senderId], references: [clerkId])

  @@index([conversationId, createdAt])
  @@index([senderId])
}
